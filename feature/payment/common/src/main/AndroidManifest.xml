<?xml version="1.0" encoding="utf-8"?>
<!--
  Tudo que existe por causa da integração com a Cielo Smart mora aqui, e não no app: a dependência
  aparece também no manifesto, e o merge do AGP a leva para o APK final sem o app precisar saber.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Obrigatório a partir do Android 11 (API 30) para que o app consiga enxergar e enviar Intents
      ao serviço de integração da Cielo Smart.
      https://docs.cielo.com.br/cielo-smart/docs/configurando-o-android-manifest
    -->
    <queries>
        <package android:name="com.ads.lio.uriappclient" />
        <!-- Pacote usado pelo Emulador Cielo para o mesmo contrato de deep link. -->
        <package android:name="br.com.cielosmart.orderservice" />
        <!--
          Consulta por intent: garante que o app enxergue quem resolve o esquema lio://,
          independentemente do pacote (emulador, terminal ou versões futuras).
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data android:scheme="lio" />
        </intent>
    </queries>

    <application>
        <!-- Identifica o app como integração por URI/deep link para a plataforma Cielo. -->
        <meta-data
            android:name="cs_integration_type"
            android:value="uri" />

        <!--
          Tela-ponte do pagamento. Não desenha nada: o tema a mantém translúcida e sem animação de
          transição, para que ela não apareça como um passo a mais entre o checkout e a Cielo.

          - exported: precisa receber o deep link de retorno, que vem de outro app;
          - singleTop: o `order://response` é reentregue a esta instância em onNewIntent, em vez de
            empilhar uma segunda;
          - o intent-filter é o contrato declarado em CieloDeepLinkBuilder.CALLBACK_URI, e fica no
            mesmo módulo que o define.
        -->
        <activity
            android:name=".PaymentActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Payment.Bridge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:host="response"
                    android:scheme="order" />
            </intent-filter>
        </activity>
    </application>

</manifest>
